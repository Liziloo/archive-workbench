{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  },
  "model": "ollama/qwen3.6:latest",
  "default_agent": "architect",
  "subagent_depth": 1,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://192.168.2.86:11434/v1",
        "headerTimeout": false,
        "timeout": false,
        "chunkTimeout": false,
        "setCacheKey": true
      },
      "models": {
        "qwen3.6:latest": {
          "name": "qwen3.6:latest",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "options": {
            "temperature": 1.0
          }
        }
      }
    }
  },
  "agent": {
    "architect": {
      "description": "Primary lead agent. Investigates the repository, plans minimal changes, delegates code execution to the Implementer, and verifies results.",
      "mode": "primary",
      "model": "ollama/qwen3.6:latest",
      "prompt": "{file:prompts/architect.md}",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": {
          "*": "deny",
          "implementer": "allow"
        }
      },
      "options": {
        "temperature": 1.0
      }
    },
    "implementer": {
      "description": "Worker subagent. Writes tests, implements targeted code changes, and runs project tests to verify execution.",
      "mode": "subagent",
      "model": "ollama/qwen3.6:latest",
      "prompt": "{file:prompts/implementer.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny"
        }
      },
      "options": {
        "temperature": 1.0
      }
    },
    "general": {
      "disable": true
    }
  },
  "username": "liz",
  "instructions": [
    "AGENTS.md",
    "docs/PROJECT.md",
    "docs/DECISIONS.md",
    "docs/ROADMAP.md"
  ]
}
